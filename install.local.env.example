# Local settings for install.sh. Copy to install.local.env (gitignored) and
# edit. Format: KEY=value, one per line; the file is read as plain text, not
# run by the shell (only a leading ~ or $HOME is expanded). An environment
# variable with the same name overrides the value here.
# Check what install.sh will use with: ./install.sh --print-config

# nginx conf.d directory of a local reverse proxy (e.g. an nginx container
# with conf.d mounted from the host). install.sh writes backup.conf there
# and reloads the proxy. Leave empty to skip the proxy and /etc/hosts steps;
# the UI is then at http://127.0.0.1:8095.
PROXY_CONF_DIR=~/proxy/conf.d

# Docker container running that nginx (for "nginx -s reload").
PROXY_CONTAINER=local-proxy

# Host name the proxy serves; install.sh adds "127.0.0.1 <name>" to
# /etc/hosts (with sudo, only when missing) and lets the service accept it.
PROXY_HOST=backup

# Optional .env file of another app to import GOOGLE_CLIENT_ID and
# GOOGLE_CLIENT_SECRET from (only those two keys are read). Leave empty to
# be asked for them.
IMPORT_ENV=~/path/to/other-app/.env

# Docker image used to build when Go >= 1.26 is not installed.
GO_IMAGE=golang:1.26
